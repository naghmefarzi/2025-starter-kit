{"metadata": {"team_id": "TREMA_UNH", "run_id": "run_7-task-2", "topic_id": "msmarco_v2.1_doc_39_1014551192", "type": "automatic", "use_starter_kit": 1}, "responses": [{"text": "The documentary Operation Varsity Blues focuses on William 'Rick' Singer, the mastermind behind the largest college admissions scandal in history.", "citations": ["msmarco_v2.1_doc_38_225958488#3_493269818"]}, {"text": "From 2011 to 2019, Singer\u2019s 'side door' was open for highly profitable business, in which Singer himself collected $25 million dollars.", "citations": ["msmarco_v2.1_doc_55_434423943#4_978425766"]}, {"text": "Singer pleaded guilty to all charges brought against him\u2014racketeering conspiracy, money laundering conspiracy, conspiracy to defraud the United States, and obstruction of justice\u2014as well on March 12, 2019.", "citations": ["msmarco_v2.1_doc_55_434423943#4_978425766"]}, {"text": "Rick Singer reportedly enrolled at Grand Canyon University in November 2019 to work towards a doctorate in psychology, but dropped out after completing only five courses in July 2020.", "citations": ["msmarco_v2.1_doc_55_434423943#4_978425766"]}]}
