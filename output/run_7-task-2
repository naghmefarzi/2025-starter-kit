{"metadata": {"team_id": "TREMA_UNH", "run_id": "run_7-task-2", "topic_id": "msmarco_v2.1_doc_15_116067546", "type": "automatic", "use_starter_kit": 1}, "responses": [{"text": "Bitcoin uses the Elliptical Curve Digital Signature Algorithm (ECDSA) and SHA-256 for encryption, which could be vulnerable to quantum computers.", "citations": ["msmarco_v2.1_doc_15_116096928#5_238045682"]}, {"text": "Google announced a 54-qubit quantum computer in October 2019, indicating progress towards powerful quantum computing capabilities.", "citations": ["msmarco_v2.1_doc_15_116096928#5_238045682"]}, {"text": "Experts like Rob Campbell from Med Cybersecurity suggest that a 4,000 qubit quantum computer could theoretically crack Bitcoin's encryption in seconds.", "citations": ["msmarco_v2.1_doc_15_116096928#5_238045682"]}, {"text": "Some blockchain leaders believe that post-quantum cryptographic algorithms are already being developed and will be ready by 2022, according to NIST's timeline.", "citations": ["msmarco_v2.1_doc_15_116096928#5_238045682"]}, {"text": "Andersen Cheng from Post-Quantum stated that government quantum computers might already exist but are not publicly disclosed, posing a potential threat to Bitcoin\u2019s security.", "citations": ["msmarco_v2.1_doc_15_116096928#5_238045682"]}]}
